.own-body{padding:clamp(24px,3vw,34px)}
.own-role{display:inline-block;font-family:"Archivo",sans-serif;font-weight:800;font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--navy);background:var(--cream-200);border-radius:999px;padding:6px 13px}
.own-body h3{font-family:"Archivo",sans-serif;font-weight:900;text-transform:uppercase;font-size:clamp(22px,2.4vw,28px);color:var(--navy-900);margin:14px 0 0;line-height:1.1}
.own-body p{margin-top:14px;font-size:16px;line-height:1.66;color:var(--ink-soft);text-wrap:pretty}
