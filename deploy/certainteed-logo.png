<!-- ============ TWEAKS PANEL ============ -->
<div id="tweaks-root"></div>
<script src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
<script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>
<script type="text/babel" src="tweaks-panel.jsx"></script>
<script type="text/babel">
const TWEAK_DEFAULTS = {
  heroTitle: "About Precision Roofing Alabama",
  heroSize: 46,
  accent: "#C79A45",
  cardBg: "#091f2e",
  showStats: true,
  stat1: "100+",
  stat2: "10+",
  stat3: "5"
};

function applyTweaks(t) {
  const root = document.documentElement;
  root.style.setProperty('--gold', t.accent);

  const h1 = document.querySelector('.page-hero h1');
  if (h1) { h1.textContent = t.heroTitle; h1.style.fontSize = t.heroSize + 'px'; }

  document.querySelectorAll('.wa-card').forEach(function (el) { el.style.background = t.cardBg; });

  const band = document.querySelector('.stats-band');
  if (band) band.style.display = t.showStats ? '' : 'none';

  const n1 = document.getElementById('statN1'); if (n1) n1.textContent = t.stat1;
  const n2 = document.getElementById('statN2'); if (n2) n2.textContent = t.stat2;
  const n3 = document.getElementById('statN3'); if (n3) n3.textContent = t.stat3;
}

function App() {
  const [t, setTweak] = useTweaks(TWEAK_DEFAULTS);
  React.useEffect(function () { applyTweaks(t); }, [t]);

  return (
    <TweaksPanel title="Tweaks">
      <TweakSection label="Page Header" />
      <TweakText label="Hero heading" value={t.heroTitle}
        onChange={function (v) { setTweak('heroTitle', v); }} />
      <TweakSlider label="Heading size" value={t.heroSize} min={28} max={72} step={1} unit="px"
        onChange={function (v) { setTweak('heroSize', v); }} />

      <TweakSection label="Brand" />
      <TweakColor label="Accent" value={t.accent}
        options={["#C79A45", "#0F364F", "#2F6B4F", "#A23B2E"]}
        onChange={function (v) { setTweak('accent', v); }} />
      <TweakColor label="Card background" value={t.cardBg}
        options={["#091f2e", "#0F364F", "#15181c"]}
        onChange={function (v) { setTweak('cardBg', v); }} />

      <TweakSection label="Stats Band" />
      <TweakToggle label="Show stats band" value={t.showStats}
        onChange={function (v) { setTweak('showStats', v); }} />
      <TweakText label="Stat 1" value={t.stat1}
        onChange={function (v) { setTweak('stat1', v); }} />
      <TweakText label="Stat 2" value={t.stat2}
        onChange={function (v) { setTweak('stat2', v); }} />
      <TweakText label="Rating" value={t.stat3}
        onChange={function (v) { setTweak('stat3', v); }} />
    </TweaksPanel>
  );
}

ReactDOM.createRoot(document.getElementById('tweaks-root')).render(<App />);
</script>
<!-- Vercel Web Analytics -->
<script defer src="/_vercel/insights/script.js"></script>
</body>
</html>
